# Copy to .env and adjust as needed. All local dev only — production values
# come from Kubernetes Secrets / AWS Secrets Manager (see ARCHITECTURE.md §6).

ENVIRONMENT=development
LOG_LEVEL=info

# --- Host port overrides ---
# Only needed if another project on your machine already binds these ports.
# Services always reach each other via the internal Compose network by
# service name regardless of these values.
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
KEYCLOAK_HOST_PORT=8080

# --- Postgres ---
POSTGRES_DB=edutech_crm
POSTGRES_USER=crm_migrate
POSTGRES_PASSWORD=change-me-migrate
POSTGRES_APP_USER=crm_app
POSTGRES_APP_PASSWORD=change-me-app
DATABASE_URL=postgresql+psycopg://crm_migrate:change-me-migrate@db:5432/edutech_crm
DATABASE_APP_URL=postgresql+psycopg://crm_app:change-me-app@db:5432/edutech_crm

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/edutech-crm
KEYCLOAK_INTERNAL_ISSUER_URL=http://keycloak:8080/realms/edutech-crm
KEYCLOAK_REALM=edutech-crm
KEYCLOAK_CLIENT_ID=web
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/edutech-crm/protocol/openid-connect/certs

# --- Service URLs ---
BACKEND_BASE_URL=http://backend:8000
BFF_BASE_URL=http://localhost:4000
BFF_PORT=4000
BACKEND_PORT=8000
WEB_PORT=5173

# Browser origin(s) the SPA is served from, comma-separated — the BFF
# answers CORS preflights for these (CLAUDE.md rule 4: it's the only
# layer that talks to the browser). Add a tunnel host (ngrok, etc.) here
# too if testing through one — also needs adding to
# keycloak/realm-export.json's redirectUris/webOrigins and
# frontend/vite.config.ts's allowedHosts, three separate allowlists for
# three separate concerns.
CORS_ORIGIN=http://localhost:5173

# Per-tenant request budget enforced by the BFF (API_CONVENTIONS.md §8),
# keyed by tenant_id, backed by the same Redis instance as REDIS_URL
# above. Defense-in-depth: an unreachable Redis fails open (no limiting)
# rather than blocking requests — see bff/src/redisClient.ts.
TENANT_RATE_LIMIT_PER_MINUTE=300

# --- Object storage (MinIO locally, S3 in production) ---
# Host-reachable (not the internal "minio:9000") — presigned URLs are
# fetched directly by the browser, not proxied through the backend
# container, so this must resolve from outside Docker. Port 9001 here
# matches docker-compose.yml's minio service host mapping; change both
# together if 9001 is also taken on your machine.
S3_ENDPOINT=http://localhost:9001
S3_BUCKET=crm-documents
S3_ACCESS_KEY=change-me-minio-access
S3_SECRET_KEY=change-me-minio-secret

# --- Lead-capture integrations (PHASE_2_PLAN.md) ---
# App-level key encrypting per-tenant Meta/Google/WhatsApp tokens at rest
# (pgcrypto pgp_sym_encrypt) — a K8s Secret in production, never committed
# as a real value.
INTEGRATION_CREDENTIALS_KEY=change-me-integration-credentials-key

# Base URLs default to the local mock-integrations service (below) — point
# at the real platform in production, same principle as S3_ENDPOINT/MinIO.
META_GRAPH_API_BASE_URL=http://mock-integrations:8000/meta
META_APP_SECRET=dev-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=dev-meta-verify-token
WHATSAPP_API_BASE_URL=http://mock-integrations:8000/whatsapp
WHATSAPP_APP_SECRET=dev-whatsapp-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-whatsapp-verify-token
GOOGLE_ADS_API_BASE_URL=http://mock-integrations:8000/google
GOOGLE_OAUTH_CLIENT_ID=dev-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=dev-google-client-secret
WEB_FORM_RATE_LIMIT_PER_MINUTE=30

# mock-integrations signs its simulated Meta/WhatsApp webhook deliveries
# with the same secrets above, so backend's real signature-verification
# code path is genuinely exercised locally (never in production — see
# ARCHITECTURE.md §5's dev-only annotation).
MOCK_INTEGRATIONS_PORT=8010

# --- Frontend (public, embedded in the built bundle) ---
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=edutech-crm
VITE_KEYCLOAK_CLIENT_ID=web
VITE_BFF_BASE_URL=http://localhost:4000
# Only used to build the embeddable web-form snippet (Integrations page,
# "web" source) — that snippet posts directly to the backend's
# POST /webhooks/web, not through the BFF. See ARCHITECTURE.md §6 /
# deploy/helm/backend/values.yaml's webhooksIngress for the production
# public-path story.
VITE_BACKEND_PUBLIC_URL=http://localhost:8000
